# Supalens environment reference.
#
# SELF-HOSTING WITH THE BUNDLED STACK (docker-compose.yml)? You do not need this file:
# run ./selfhost.sh — it asks for the address and an Anthropic API key and generates .env.
# That install needs Docker and the Anthropic key, and nothing else.
#
# This reference is for the other cases: local development, your own Supabase project
# (docker-compose.external.yml), Trigger.dev, optional integrations, and the hosted service.
#
# Markers: [build] = NEXT_PUBLIC_*, inlined into the browser bundle at build time (changing one
# means rebuilding) · [web] = the web server · [trigger] = the Trigger.dev host, only when tasks
# run there · [both] = web + trigger.

# ═════════════════════════════════════════════════════════
# 1. Edition and origin
# ═════════════════════════════════════════════════════════
# selfhost = the product only, no plan limits. cloud = the hosted service (marketing site,
# billing, public demo, X-ray). [build] + [trigger]
NEXT_PUBLIC_SUPALENS_EDITION=selfhost
# Public origin of this install — every link in emails, Slack messages and share URLs is built
# from it. [build] + [trigger]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═════════════════════════════════════════════════════════
# 2. Supabase (auth + application database)
# ═════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url          # [build] + [trigger]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key        # [build]
# Service-role key (secrets vault + privileged writes). NEVER expose to the browser. [both]
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Only for the Supabase CLI (npm run db:*).
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_DB_PASSWORD=your_database_password

# Hosted edition only — sign-in methods the login form shows, comma-separated: google, kakao,
# github, email_link, password (default google,kakao,github,email_link). A self-hosted install
# is always email + password with accounts created inside the app. [build]
# NEXT_PUBLIC_AUTH_PROVIDERS=google,kakao,github,email_link

# Bundled stack only (set by docker-compose.yml): the address the SERVER uses to reach Supabase,
# and a fixed session-cookie name so browser and server agree when their addresses differ.
# SUPABASE_INTERNAL_URL=http://gateway
# NEXT_PUBLIC_SUPABASE_COOKIE_NAME=sb-supalens-auth-token

# ═════════════════════════════════════════════════════════
# 3. Secrets encryption (envelope: a KEK wraps one DEK per tenant) [both — same value]
# ═════════════════════════════════════════════════════════
#   local  : the key lives in this variable. Generate with `openssl rand -base64 32`, back it up,
#            and never change it without running scripts/rotate-kek.ts — losing it loses every
#            stored database credential.
#   gcp_kms: KEK_GCP_KEY = projects/*/locations/*/keyRings/*/cryptoKeys/* (install @google-cloud/kms)
KEK_PROVIDER=local
KEK_LOCAL_MASTER_KEY=your_base64_32byte_master_key
# KEK_LOCAL_MASTER_KEY_PREVIOUS=   # only during a rotation
# KEK_GCP_KEY=projects/your-project/locations/global/keyRings/your-ring/cryptoKeys/your-key

# ═════════════════════════════════════════════════════════
# 4. Agents and scheduled jobs
# ═════════════════════════════════════════════════════════
# The model behind the agents. Needed wherever tasks run: the web server (built-in runner) or
# the Trigger.dev host. Choose ONE provider.
#
# (a) Anthropic — the default, and the most tested.
ANTHROPIC_API_KEY=your_anthropic_api_key
#
# (b) Any OpenAI-compatible endpoint with tool calling: OpenAI, Google Gemini, OpenRouter, Groq,
#     Azure OpenAI, or a local server (Ollama, vLLM, LM Studio). Tool calling must be reliable —
#     small local models often are not.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1        # Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#                                               # Ollama: http://host.docker.internal:11434/v1
# LLM_API_KEY=your_key                          # leave empty for a local server
# LLM_MODEL=your-main-model                     # required
# LLM_MODEL_SMALL=your-cheaper-model            # optional: digests and alert explanations
# LLM_HEADERS={"HTTP-Referer":"https://bi.example.com"}   # optional extra request headers (JSON)

# Where tasks run. Self-hosted default: INSIDE the web server (nothing to configure).
# SUPALENS_MAX_CONCURRENT_TASKS=4   # built-in runner: tasks running at once [web]
#
# To use Trigger.dev instead (durable runs, per-run isolation) build with
# SUPALENS_TASK_BACKEND=trigger and set the two values below. The hosted edition always uses
# Trigger.dev. The CLI reads them from `.env` (or --env-file).
# SUPALENS_TASK_BACKEND=trigger
# TRIGGER_PROJECT_REF=proj_replace_me
# TRIGGER_SECRET_KEY=tr_prod_secret_key                     # [web]
# Self-hosted Trigger.dev only: its API origin, for the server SDK and the browser stream hooks.
# TRIGGER_API_URL=https://trigger.example.com               # [web]
# NEXT_PUBLIC_TRIGGER_API_URL=https://trigger.example.com   # [build]
# TRIGGER_WORKER_ARCH=arm64                                 # CLI only; workers are x64 by default
# Anthropic model selection (src/lib/agent/models.ts). Unset = the defaults.
# ANALYSIS_MODEL=claude-sonnet-5
# SYSTEM_RUN_MODEL=claude-haiku-4-5-20251001

# ═════════════════════════════════════════════════════════
# 5. Email — alerts and weekly digest [both]. Optional.
# ═════════════════════════════════════════════════════════
# Any mail server over SMTP (smtp:// with STARTTLS, smtps:// for implicit TLS). Without a
# transport nothing is sent and the UI says so; alerts still reach Slack/Discord webhooks.
# SMTP_URL=smtp://user:password@mail.example.com:587
# EMAIL_FROM="Supalens <bi@example.com>"
# EMAIL_REPLY_TO=support@example.com
# Alternative transport: Resend (used when SMTP_URL is unset).
# RESEND_API_KEY=re_your_api_key
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com   # contact line in the welcome email
# EMAIL_POSTAL_ADDRESS="Your company, street, city"

# ═════════════════════════════════════════════════════════
# 6. Connecting databases on private networks [both]
# ═════════════════════════════════════════════════════════
#   ALLOW_PRIVATE_DB_HOSTS — may sources point at private/loopback addresses?
#     self-hosted default: yes (set false to block) · hosted default: no (set true for local dev)
#   DB_TLS_INSECURE=true — never verify database certificates. Prefer the per-source option
#     "SSL — don't verify the certificate" in the connection form.
# ALLOW_PRIVATE_DB_HOSTS=false
# DB_TLS_INSECURE=false

# ═════════════════════════════════════════════════════════
# 7. Optional integrations — each is inert until its variables are set.
#    A self-hoster registers their OWN app with each provider.
# ═════════════════════════════════════════════════════════

# ── "Connect Supabase" (Management API OAuth) [both]
# Supabase Dashboard → Organization settings → OAuth Apps. Scopes: Projects(read), Database(read+write).
# SUPA_CONNECT_CLIENT_ID=your_oauth_app_client_id
# SUPA_CONNECT_CLIENT_SECRET=your_oauth_app_client_secret
# SUPA_CONNECT_REDIRECT_URI=http://localhost:3000/api/connect-supabase/callback
# SUPA_CONNECT_SCOPES=projects:read,database:read,database:write

# ── GitHub App ("Connect GitHub": clone + push webhook + code analysis) [both]
# GitHub → Settings → Developer settings → GitHub Apps → New
#   Permissions: Metadata read, Contents read · Subscribe to: Push
#   Webhook URL: <origin>/api/github/webhook · Setup URL: <origin>/api/connect-github/callback
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=your-app-slug
# The App's RSA key PEM, newlines escaped as \n on one line.
# GITHUB_APP_PRIVATE_KEY="<paste the full PEM here, newlines escaped as \n>"
# GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret
# GITHUB_APP_REDIRECT_URI=http://localhost:3000/api/connect-github/callback

# ── Slack app (alerts to channels + @mention answers) [web]
# api.slack.com/apps → bot scopes app_mentions:read, chat:write, channels:read, groups:read ·
# Events request URL <origin>/api/slack/events · slash command → <origin>/api/slack/commands
# SLACK_CLIENT_ID=1234567890.1234567890
# SLACK_CLIENT_SECRET=your_client_secret
# SLACK_SIGNING_SECRET=your_signing_secret
# SLACK_REDIRECT_URI=http://localhost:3000/api/connect-slack/callback

# ── Sample dataset: a DEDICATED read-only Postgres seeded with demo/seed.sql (never the app DB).
# Every org gets it as a read-only source to try before connecting their own. [both]
# DEMO_DATABASE_URL=postgresql://supalens_demo_ro:password@host:5432/db?sslmode=require

# ── MCP connect URL shown in Settings → Developer. Default: <NEXT_PUBLIC_APP_URL>/api/mcp/mcp. [build]
# NEXT_PUBLIC_MCP_URL=https://mcp.example.com/mcp
# Server pepper mixed into API-key hashes. Set ONCE before issuing keys; changing it invalidates
# every issued key. [web]
# API_KEY_PEPPER=your_random_pepper

# ── Abuse caps. 0 disables. Defaults: selfhost 0 / cloud 200 runs per org per day, 3 orgs per user.
# MAX_RUNS_PER_ORG_PER_DAY=200
# MAX_ORGS_PER_USER=3
# MAX_INVITES_PER_ORG_PER_DAY=30
# MAX_INVITES_PER_EMAIL_PER_HOUR=3

# ═════════════════════════════════════════════════════════
# 8. Hosted-service features (NEXT_PUBLIC_SUPALENS_EDITION=cloud only)
# ═════════════════════════════════════════════════════════

# ── Paddle Billing (subscriptions + metered quotas) — docs/paddle-billing-plan.md [web]
# Without PADDLE_API_KEY billing is off: no checkout and no plan enforcement.
# PADDLE_WEBHOOK_SECRET is optional (without it provisioning runs through the API-verified sync).
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox                 # sandbox | production
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token
# PADDLE_API_KEY=pdl_sdbx_apikey_your_key
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret
# PADDLE_PRICE_ID_BASIC=pri_your_basic
# PADDLE_PRICE_ID_STANDARD=pri_your_standard
# PADDLE_PRICE_ID_PREMIUM=pri_your_premium
# Yearly (optional): PADDLE_PRICE_ID_BASIC_YEARLY / _STANDARD_YEARLY / _PREMIUM_YEARLY
# PADDLE_PRICE_ID_ADMIN_TEST=pri_your_admin_test          # staff-only test price
# Usage-based overage (off by default; validate the rate against real run cost first).
# OVERAGE_BILLING_ENABLED=true
# OVERAGE_USD_PER_QUERY=0.30
# OVERAGE_PADDLE_PRODUCT_ID=pro_your_overage_product

# ── Public no-signup demo (/demo): an org row with no members that backs anonymous runs. [both]
# PUBLIC_DEMO_ORG_ID=
# DEMO_RUNS_PER_VISITOR_PER_DAY=5
# DEMO_MAX_RUNS_PER_DAY=150
# DEMO_MAX_INFLIGHT=4
# DEMO_IP_SALT=

# ── X-ray (/x): anonymous public-repo reports. Its own daily budget is the cost ceiling. [web]
# XRAY_GITHUB_TOKEN=            # no-scope token: 5k/h GitHub API instead of 60/h
# XRAY_SCANS_PER_VISITOR_PER_DAY=3
# XRAY_MAX_SCANS_PER_DAY=60
# XRAY_MAX_INFLIGHT=4
# XRAY_MAX_REPO_KB=250000

# ── Error tracking (Sentry). DSNs are not secret; unset = disabled.
# SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0              # [both]
# NEXT_PUBLIC_SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0  # [build]
# SENTRY_ORG=your-org-slug          # source-map upload at build time
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_your_token

# ── Product analytics [build]. Never loaded on a self-hosted install.
# NEXT_PUBLIC_GAID=your_google_analytics_id
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Marketing telemetry to external systems. Every send is a no-op while unset. [both]
# CONTENT_AGENT_TRACKING_URL=
# CONTENT_AGENT_TRACKING_TOKEN=
# STREAMIZE_EVENTS_URL=
# STREAMIZE_EVENTS_KEY=

# ═════════════════════════════════════════════════════════
# E2E testing (see .env.test for the local Supabase settings)
# ═════════════════════════════════════════════════════════
# E2E_BASE_URL=http://localhost:3000
