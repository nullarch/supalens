{
  "name": "supalens",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/build-mcp-app.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/build-mcp-app.mjs",
    "build": "next build",
    "build:mcp-app": "node scripts/build-mcp-app.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:new": "supabase migration new",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint",
    "db:dump": "supabase db dump -f supabase/dump.sql",
    "db:link": "supabase link --project-ref $SUPABASE_PROJECT_REF",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF --schema public > src/utils/supabase/schema.type.ts",
    "trigger:dev": "npx trigger.dev@$(node -p \"require('@trigger.dev/sdk/package.json').version\") dev",
    "trigger:deploy": "npx trigger.dev@$(node -p \"require('@trigger.dev/sdk/package.json').version\") deploy",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report e2e/reports",
    "icons:gen": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.195",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@google-cloud/firestore": "^8.6.0",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@next/third-parties": "^15.1.5",
    "@paddle/paddle-js": "^1.6.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/nextjs": "^10.63.0",
    "@sentry/node": "^10.63.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.16",
    "@trigger.dev/react-hooks": "^4.6.4",
    "@trigger.dev/sdk": "^4.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.473.0",
    "mcp-handler": "^2.3.1",
    "mysql2": "^3.22.5",
    "next": "^15.1.11",
    "next-intl": "^4.13.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.22.0",
    "posthog-js": "^1.396.6",
    "pretendard": "^1.3.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "resend": "^6.16.0",
    "satori": "0.33.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.57.0",
    "@trigger.dev/build": "^4.6.4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^15.1.11",
    "postcss": "^8",
    "supabase": "^2.6.8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
